<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:SoundLibert.UI.Controls"
             x:Class="SoundLibert.UI.Controls.PageHero">

    <!-- The opening of every detail page: its cover, its own colour, its name. -->
    <Panel>
        <controls:CoverGlow x:Name="Glow" VerticalAlignment="Stretch"/>
        <Grid x:Name="Layout" ColumnDefinitions="Auto,*" ColumnSpacing="28" Margin="{x:Static controls:PageLayout.Hero}">
            <Border x:Name="ArtShadow" Width="200" Height="200" CornerRadius="14"
                    BoxShadow="0 18 50 #80000000" VerticalAlignment="Bottom">
                <Border x:Name="ArtClip" CornerRadius="14" ClipToBounds="True"
                        Background="{DynamicResource ArtGradient}">
                    <Panel>
                        <controls:Icon x:Name="GlyphIcon" Kind="Music" Size="72"
                                       Foreground="{DynamicResource TextDimBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <controls:CoverMosaic x:Name="Cover"/>
                    </Panel>
                </Border>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="8">
                <TextBlock x:Name="EyebrowText" Classes="eyebrow"/>
                <TextBlock x:Name="TitleText" Classes="display" TextWrapping="Wrap"
                           MaxLines="2" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SubtitleText" FontSize="14" FontWeight="Medium"
                           Foreground="{DynamicResource TextMidBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="MetaText" FontSize="12.5"
                           Foreground="{DynamicResource TextDimBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <Decorator x:Name="ActionsHost" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
    </Panel>
</UserControl>
