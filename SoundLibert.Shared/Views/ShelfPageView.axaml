<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SoundLibert.UI.ViewModels"
             xmlns:views="using:SoundLibert.UI.Views"
             xmlns:controls="using:SoundLibert.UI.Controls"
             x:Class="SoundLibert.UI.Views.ShelfPageView"
             x:DataType="vm:ShelfPageViewModel">

    <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Disabled"
                  ScrollChanged="PageScroll_ScrollChanged">
        <Panel>
            <!-- The page's own colour melts into the sheet. -->
            <Border Height="300" VerticalAlignment="Top" IsHitTestVisible="False" Background="{Binding Wash}"/>
            <StackPanel Margin="{x:Static controls:PageLayout.ShelfPageBody}" Spacing="28">
                <StackPanel Spacing="6">
                    <TextBlock Classes="eyebrow" Text="{Binding Eyebrow}" IsVisible="{Binding HasEyebrow}"/>
                    <TextBlock Classes="display" Text="{Binding Title}"/>
                </StackPanel>

                <controls:SkeletonPlaceholder Kind="Cards" Count="6" IsVisible="{Binding IsLoading}" ClipToBounds="True"/>

                <TextBlock Text="{Binding EmptyMessage}" FontSize="13.5"
                           Foreground="{DynamicResource TextDimBrush}"
                           IsVisible="{Binding ShowEmpty}"/>

                <views:ShelfStack Shelves="{Binding Shelves}"/>
            </StackPanel>
        </Panel>
    </ScrollViewer>
</UserControl>
