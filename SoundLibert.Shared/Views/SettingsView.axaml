<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SoundLibert.UI.ViewModels"
             xmlns:controls="using:SoundLibert.UI.Controls"
             xmlns:services="using:SoundLibert.UI.Services"
             x:Class="SoundLibert.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Grid RowDefinitions="Auto,*" Margin="{x:Static controls:PageLayout.SettingsBody}">
        <TextBlock Grid.Row="0" Classes="display" Text="Settings" Margin="0,0,0,18"/>

        <TabControl Grid.Row="1">

            <!-- ================= Account ================= -->
            <TabItem Header="Account">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <controls:ReadingStack Margin="0,20,0,40" Spacing="16">
                        <Border Classes="group" Padding="20">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                <Border Width="60" Height="60" CornerRadius="999" ClipToBounds="True"
                                        Background="{DynamicResource FillHoverBrush}">
                                    <Panel>
                                        <controls:Icon Kind="User" Size="28"
                                                       Foreground="{DynamicResource TextDimBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <controls:RemoteImage Url="{Binding AccountAvatarUrl}" Stretch="UniformToFill"/>
                                    </Panel>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="{Binding AccountDisplay}" FontSize="16" FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding AccountSubtitle}" FontSize="12.5"
                                               Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"
                                               IsVisible="{Binding AccountSubtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock Classes="setting-note"
                                   Text="Signing in loads your YouTube Music library, playlists and subscriptions. The session cookie is stored only on this device, and nothing is ever written to your account."/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="primary" IsVisible="{Binding !IsSignedIn}" Click="SignIn_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <controls:Icon Kind="SignIn" Size="17" VerticalAlignment="Center"/>
                                    <TextBlock Text="Sign in with Google" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Content="Sign in again" Classes="primary"
                                    IsVisible="{Binding NeedsReauthentication}" Click="SignIn_Click"
                                    ToolTip.Tip="Your library is kept; signing in again resumes syncing"/>
                            <Button Content="Re-import library" Classes="ghost"
                                    IsVisible="{Binding IsSignedIn}"
                                    Click="Reimport_Click"
                                    ToolTip.Tip="Re-import your YouTube Music likes, albums, artists and playlists"/>
                            <Button Content="Sign out" Classes="quiet" MinHeight="40"
                                    IsVisible="{Binding IsSignedIn}"
                                    Command="{Binding SignOutCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding AccountStatus}" FontSize="12.5"
                                   Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                                   IsVisible="{Binding AccountStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </controls:ReadingStack>
                </ScrollViewer>
            </TabItem>

            <!-- ================= Playback ================= -->
            <TabItem Header="Playback">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <controls:ReadingStack Margin="0,20,0,40">
                        <Border Classes="group">
                            <StackPanel>
                                <Border Classes="setting">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <TextBlock Classes="setting-title" Text="Autoplay"/>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding Autoplay}"/>
                                    </Grid>
                                </Border>
                                <Border Classes="setting">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <TextBlock Classes="setting-title" Text="Resume where you left off"/>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding RememberLastSession}"/>
                                    </Grid>
                                </Border>
                                <Border Classes="setting">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <TextBlock Classes="setting-title" Text="Start shuffled"/>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShuffleOnByDefault}"/>
                                    </Grid>
                                </Border>
                                <Border Classes="setting">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <TextBlock Classes="setting-title" Text="Repeat on startup"/>
                                        <ComboBox Grid.Column="1" MinWidth="130"
                                                  ItemsSource="{Binding RepeatModes}"
                                                  SelectedItem="{Binding RepeatMode}"/>
                                    </Grid>
                                </Border>
                                <Border Classes="setting">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <TextBlock Classes="setting-title" Text="Video quality"/>
                                        <ComboBox Grid.Column="1" MinWidth="130"
                                                  ItemsSource="{Binding VideoQualities}"
                                                  SelectedIndex="{Binding VideoQualityIndex}"/>
                                    </Grid>
                                </Border>
                                <Border Classes="setting last">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Classes="setting-title" Text="Audio quality"/>
                                            <TextBlock Classes="setting-note"
                                                       Text="Data saver streams the lowest bitrate."/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" MinWidth="130"
                                                  ItemsSource="{Binding AudioQualities}"
                                                  SelectedIndex="{Binding AudioQualityIndex}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- AI-generated music: out of what is recommended, still there when asked for. -->
                        <TextBlock Classes="eyebrow" Text="AI MUSIC" Margin="2,22,0,10"/>
                        <Border Classes="group">
                            <StackPanel>
                                <Border Classes="setting" Classes.last="{Binding !HasAiMarks}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Classes="setting-title" Text="Don't recommend AI-generated music"/>
                                            <TextBlock Classes="setting-note" Text="{Binding AiMusicNote}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding HideAiMusic}"/>
                                    </Grid>
                                </Border>
                                <Border Classes="setting last" IsVisible="{Binding HasAiMarks}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <TextBlock Classes="setting-title" Text="Artists you marked" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="Forget" Classes="quiet"
                                                VerticalAlignment="Center" Command="{Binding ClearAiMarksCommand}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </controls:ReadingStack>
                </ScrollViewer>
            </TabItem>

            <!-- ================= Audio ================= -->
            <TabItem Header="Audio">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <controls:ReadingStack Margin="0,20,0,40" Spacing="16">
                        <Border Classes="group">
                            <StackPanel>
                                <Border Classes="setting" IsVisible="{x:Static services:PlatformFeatures.OutputDevices}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Classes="setting-title" Text="Output device"/>
                                            <TextBlock Classes="setting-note" Text="Applies to the next track you play."/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" MinWidth="220" MaxWidth="280"
                                                  ItemsSource="{Binding OutputDevices}"
                                                  SelectedIndex="{Binding OutputDeviceIndex}"/>
                                    </Grid>
                                </Border>
                                <Border Classes="setting">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Classes="setting-title" Text="Normalize volume"/>
                                            <TextBlock Classes="setting-note" Text="Evens out loud tracks."/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding NormalizeVolume}"/>
                                    </Grid>
                                </Border>
                                <Border Classes="setting" Classes.last="{Binding !CrossfadeEnabled}"
                                        IsVisible="{x:Static services:PlatformFeatures.Crossfade}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Classes="setting-title" Text="Crossfade"/>
                                            <TextBlock Classes="setting-note"
                                                       Text="Fades the end of one track into the start of the next."/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding CrossfadeEnabled}"/>
                                    </Grid>
                                </Border>
                                <Border Classes="setting last" IsVisible="{Binding ShowCrossfadeLength}">
                                    <Grid ColumnDefinitions="72,*,44" ColumnSpacing="10">
                                        <TextBlock Text="Length" FontSize="13"
                                                   Foreground="{DynamicResource TextDimBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1" Classes="knob soft" Minimum="1" Maximum="12"
                                                TickFrequency="1" IsSnapToTickEnabled="True"
                                                Value="{Binding CrossfadeSeconds}"/>
                                        <TextBlock Grid.Column="2" Classes="time" TextAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding CrossfadeSeconds, StringFormat='{}{0:0} s'}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Classes="eyebrow" Text="EQUALIZER" Margin="2,6,0,-4"/>
                        <Border Classes="group">
                            <StackPanel>
                                <Border Classes="setting">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <TextBlock Classes="setting-title" Text="Preset"/>
                                        <ComboBox Grid.Column="1" MinWidth="150"
                                                  ItemsSource="{Binding EqPresets}"
                                                  SelectedItem="{Binding EqPreset}"/>
                                    </Grid>
                                </Border>
                                <Border Classes="setting last">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="72,*" ColumnSpacing="10">
                                            <TextBlock Text="Bass" FontSize="13"
                                                       Foreground="{DynamicResource TextDimBrush}"
                                                       VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" Classes="knob soft" Minimum="-12" Maximum="12"
                                                    Value="{Binding EqBass}"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="72,*" ColumnSpacing="10">
                                            <TextBlock Text="Mid" FontSize="13"
                                                       Foreground="{DynamicResource TextDimBrush}"
                                                       VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" Classes="knob soft" Minimum="-12" Maximum="12"
                                                    Value="{Binding EqMid}"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="72,*" ColumnSpacing="10">
                                            <TextBlock Text="Treble" FontSize="13"
                                                       Foreground="{DynamicResource TextDimBrush}"
                                                       VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" Classes="knob soft" Minimum="-12" Maximum="12"
                                                    Value="{Binding EqTreble}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </controls:ReadingStack>
                </ScrollViewer>
            </TabItem>

            <!-- ================= Display & window ================= -->
            <TabItem Header="Display">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <controls:ReadingStack Margin="0,20,0,40" Spacing="16">
                        <Border Classes="group">
                            <StackPanel>
                                <Border Classes="setting">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Classes="setting-title" Text="Animated cover"/>
                                            <TextBlock Classes="setting-note" Text="A muted looping clip behind the full player, when the track has an official video."/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowCanvas}"/>
                                    </Grid>
                                </Border>
                                <Border Classes="setting">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Classes="setting-title" Text="Reduce motion"/>
                                            <TextBlock Classes="setting-note" Text="Calms the moving background and page animations."/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding ReduceMotion}"/>
                                    </Grid>
                                </Border>
                                <Border Classes="setting">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Classes="setting-title" Text="Lyrics"/>
                                            <TextBlock Classes="setting-note" Text="Synced lyrics from LRCLIB."/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding LyricsEnabled}"/>
                                    </Grid>
                                </Border>
                                <Border Classes="setting">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <TextBlock Classes="setting-title" Text="Show the current lyric line"/>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowSingleLyric}"/>
                                    </Grid>
                                </Border>
                                <Border Classes="setting last">
                                    <Grid ColumnDefinitions="Auto,*,36" ColumnSpacing="14">
                                        <TextBlock Classes="setting-title" Text="Lyrics text size"/>
                                        <Slider Grid.Column="1" Classes="knob soft" Minimum="11" Maximum="30"
                                                TickFrequency="1" IsSnapToTickEnabled="True"
                                                Value="{Binding LyricsFontSize}"/>
                                        <TextBlock Grid.Column="2" Classes="time" TextAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding LyricsFontSize, StringFormat='{}{0:0}'}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Classes="eyebrow" Text="WINDOW" Margin="2,6,0,-4"
                                   IsVisible="{x:Static services:PlatformFeatures.Tray}"/>
                        <Border Classes="group" IsVisible="{x:Static services:PlatformFeatures.Tray}">
                            <StackPanel>
                                <Border Classes="setting">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <TextBlock Classes="setting-title" Text="Minimize to tray"/>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding MinimizeToTray}"/>
                                    </Grid>
                                </Border>
                                <Border Classes="setting">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <TextBlock Classes="setting-title" Text="Close to tray"/>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding CloseToTray}"/>
                                    </Grid>
                                </Border>
                                <Border Classes="setting last">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Classes="setting-title" Text="Start minimized"/>
                                            <TextBlock Classes="setting-note" Text="Opens hidden in the tray."/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding StartMinimized}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Classes="group">
                            <Border Classes="setting last">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Classes="setting-title" Text="Clear cache"/>
                                        <TextBlock Classes="setting-note"
                                                   Text="Forgets downloaded covers, artwork colours and cached lyrics."/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Clear" Classes="ghost" VerticalAlignment="Center"
                                            Command="{Binding ClearCacheCommand}"/>
                                </Grid>
                            </Border>
                        </Border>
                    </controls:ReadingStack>
                </ScrollViewer>
            </TabItem>

            <!-- ================= Downloads ================= -->
            <TabItem Header="Downloads">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <controls:ReadingStack Margin="0,20,0,40">
                        <Border Classes="group">
                            <StackPanel>
                                <Border Classes="setting" IsVisible="{x:Static services:PlatformFeatures.DownloadFolder}">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Classes="setting-title" Text="Folder"/>
                                            <TextBlock Classes="setting-note" Text="{Binding DownloadsFolderText}"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="icon" Click="OpenDownloads_Click"
                                                IsVisible="{x:Static services:PlatformFeatures.DownloadFolder}"
                                                VerticalAlignment="Center" ToolTip.Tip="Open folder">
                                            <controls:Icon Kind="External" Size="18"/>
                                        </Button>
                                        <Button Grid.Column="2" Content="Change…" Classes="ghost"
                                                IsVisible="{x:Static services:PlatformFeatures.DownloadFolder}"
                                                VerticalAlignment="Center" Click="ChangeDownloads_Click"/>
                                    </Grid>
                                </Border>
                                <Border Classes="setting last">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <TextBlock Classes="setting-title" Text="{Binding DownloadsStatsText}"/>
                                        <Button Grid.Column="1" Content="Remove all" Classes="quiet danger"
                                                VerticalAlignment="Center" Click="ClearDownloads_Click"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </controls:ReadingStack>
                </ScrollViewer>
            </TabItem>

            <!-- ================= Updates ================= -->
            <TabItem Header="Updates">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <controls:ReadingStack Margin="0,20,0,40" Spacing="16">
                        <!-- Where the app stands, and the one thing to do about it. -->
                        <Border Classes="group">
                            <StackPanel>
                                <Border Classes="setting">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                        <controls:BrandIcon Width="48" Height="48" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Classes="setting-title" FontSize="16"
                                                       Text="{Binding Version, StringFormat='SoundLibert {0}'}"/>
                                            <TextBlock Classes="setting-note" Text="{Binding Updates.StatusText}"
                                                       IsVisible="{x:Static services:PlatformFeatures.SelfUpdate}"/>
                                            <ProgressBar IsVisible="{Binding Updates.IsBusy}"
                                                         IsIndeterminate="{Binding Updates.IsChecking}"
                                                         Value="{Binding Updates.Progress}" Maximum="100"
                                                         Width="240" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                    IsVisible="{x:Static services:PlatformFeatures.SelfUpdate}">
                                            <Button Classes="primary"
                                                    IsVisible="{Binding Updates.IsReadyToRestart}"
                                                    Command="{Binding RestartToUpdateCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <controls:Icon Kind="Update" Size="16" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Restart to update" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Content="Check for updates" Classes="ghost"
                                                    IsVisible="{Binding !Updates.IsReadyToRestart}"
                                                    IsEnabled="{Binding !Updates.IsBusy}"
                                                    Command="{Binding CheckForUpdatesCommand}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Classes="setting" IsVisible="{x:Static services:PlatformFeatures.SelfUpdate}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Classes="setting-title" Text="Check automatically"/>
                                            <TextBlock Classes="setting-note"
                                                       Text="New versions download in the background. A card says when one is ready, and it installs when you restart."/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoCheckUpdates}"/>
                                    </Grid>
                                </Border>
                                <Border Classes="setting last">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Classes="setting-title" Text="Every version"/>
                                            <TextBlock Classes="setting-note" Text="What changed in each release, on GitHub."/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="icon" VerticalAlignment="Center" Click="Releases_Click"
                                                ToolTip.Tip="Open on GitHub">
                                            <controls:Icon Kind="External" Size="18"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- What the new version changes. -->
                        <Border Classes="group" IsVisible="{Binding Updates.HasNotes}">
                            <StackPanel Margin="18,14,18,16" Spacing="8">
                                <TextBlock Classes="setting-title"
                                           Text="{Binding Updates.AvailableVersion, StringFormat='New in {0}'}"/>
                                <SelectableTextBlock Text="{Binding Updates.ReleaseNotes}" FontSize="13" LineHeight="20"
                                                     TextWrapping="Wrap" Foreground="{DynamicResource TextMidBrush}"/>
                            </StackPanel>
                        </Border>
                    </controls:ReadingStack>
                </ScrollViewer>
            </TabItem>

            <!-- ================= About ================= -->
            <TabItem Header="About">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <controls:ReadingStack Margin="0,20,0,40" Spacing="16">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" Margin="2,0,0,4">
                            <controls:BrandIcon Width="60" Height="60"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="SoundLibert" FontSize="20" FontWeight="Bold" LetterSpacing="-0.4"/>
                                <TextBlock Classes="caption" FontSize="12.5"
                                           Text="{Binding Version, StringFormat='Version {0}'}"/>
                            </StackPanel>
                        </Grid>

                        <Border Classes="group">
                            <StackPanel>
                                <Border Classes="setting">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Classes="setting-title" Text="Report a bug"/>
                                            <TextBlock Classes="setting-note" Text="Something broken or an idea? It opens as an issue on GitHub."/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="ghost" VerticalAlignment="Center" Click="ReportBug_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <controls:Icon Kind="Bug" Size="17" VerticalAlignment="Center"/>
                                                <TextBlock Text="Report" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                                <Border Classes="setting">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Classes="setting-title" Text="Support SoundLibert"/>
                                            <TextBlock Classes="setting-note" Text="Free and open source: support keeps it going."/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="primary" VerticalAlignment="Center" Click="Support_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <controls:Icon Kind="Heart" Size="16" IsFilled="True" VerticalAlignment="Center"/>
                                                <TextBlock Text="Support" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                                <Border Classes="setting">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Classes="setting-title" Text="Welcome"/>
                                            <TextBlock Classes="setting-note" Text="See it again, and choose the artists Home starts from."/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Show" Classes="ghost" VerticalAlignment="Center"
                                                Click="ShowWelcome_Click"/>
                                    </Grid>
                                </Border>
                                <Border Classes="setting">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Classes="setting-title" Text="SoundLibert on GitHub"/>
                                            <TextBlock Classes="setting-note" Text="The source code. A star helps other people find it."/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="ghost" VerticalAlignment="Center" Click="GitHub_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <controls:Icon Kind="Star" Size="16" VerticalAlignment="Center"/>
                                                <TextBlock Text="Star on GitHub" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                                <Border Classes="setting last" IsVisible="{x:Static services:PlatformFeatures.DownloadFolder}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Classes="setting-title" Text="Logs"/>
                                            <TextBlock Classes="setting-note" Text="The folder with the app log and crash log."/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="icon" VerticalAlignment="Center" Click="OpenLogs_Click"
                                                ToolTip.Tip="Open folder">
                                            <controls:Icon Kind="Folder" Size="18"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="6" Margin="2,4,0,0">
                            <TextBlock Classes="setting-note"
                                       Text="Licensed under the GNU General Public License v3.0. Thanks to the Velune project (GPL-3.0), whose InnerTube, stream-resolution, radio and lyrics work inspired this app, plus Avalonia UI, NAudio, CommunityToolkit.Mvvm, Microsoft.Data.Sqlite, LRCLIB and Lucide. The list of AI-generated artists comes from spotify-ai-blocker (CennoxX), built on loved.music, Zoundhub and Spotify AI Blocklist. Full list in CREDITS.md."/>
                            <TextBlock Classes="setting-note"
                                       Text="Unofficial client. Not affiliated with or endorsed by YouTube or Google. All music belongs to its rights holders."/>
                        </StackPanel>
                    </controls:ReadingStack>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
