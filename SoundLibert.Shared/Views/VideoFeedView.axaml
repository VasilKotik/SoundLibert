<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SoundLibert.UI.ViewModels"
             xmlns:models="using:SoundLibert.Domain.Models"
             xmlns:controls="using:SoundLibert.UI.Controls"
             x:Class="SoundLibert.UI.Views.VideoFeedView"
             x:DataType="vm:VideoFeedViewModel">

    <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Disabled"
                  ScrollChanged="PageScroll_ScrollChanged">
        <StackPanel Margin="0,0,0,40" Spacing="22">
            <controls:PageHero Eyebrow="VIDEOS" ArtSize="140"
                               IsRound="{Binding IsRound}"
                               Glyph="{Binding Glyph}"
                               Title="{Binding Title}"
                               Meta="{Binding CountText}"
                               ImageUrl="{Binding ThumbnailUrl}"
                               ImageUrls="{Binding CoverUrls}">
                <controls:PageHero.Actions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="play" Command="{Binding PlayAllCommand}"
                                IsVisible="{Binding HasVideos}" ToolTip.Tip="Play all">
                            <controls:Icon Kind="Play" Size="22"/>
                        </Button>
                        <Button Classes="icon lg" Command="{Binding ShuffleAllCommand}"
                                IsVisible="{Binding HasVideos}" ToolTip.Tip="Shuffle">
                            <controls:Icon Kind="Shuffle" Size="21"/>
                        </Button>
                        <Button Classes="icon lg" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh">
                            <controls:Icon Kind="Refresh" Size="20"/>
                        </Button>
                    </StackPanel>
                </controls:PageHero.Actions>
            </controls:PageHero>

            <controls:SkeletonPlaceholder Kind="WideCards" Count="6" Margin="{x:Static controls:PageLayout.Side}" IsVisible="{Binding IsLoading}"/>

            <TextBlock Text="{Binding EmptyMessage}" FontSize="13.5" Margin="{x:Static controls:PageLayout.Side}"
                       Foreground="{DynamicResource TextDimBrush}"
                       IsVisible="{Binding ShowEmpty}"/>

            <ItemsControl ItemsSource="{Binding Videos}" Margin="{x:Static controls:PageLayout.Side}" IsVisible="{Binding HasVideos}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:AdaptiveGrid MinItemWidth="240"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:SongItem">
                        <controls:CoverCard Shape="Wide" CanPlay="False"
                                            Title="{Binding Title}" Subtitle="{Binding ArtistDisplay}"
                                            ImageUrl="{Binding ThumbnailUrl}" Tag="{Binding}"
                                            Badge="{Binding DurationBadge}"
                                            Tapped="Video_Tapped"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- The next videos are on their way, or could not be fetched. -->
            <controls:SkeletonPlaceholder Kind="WideCards" Count="3" Margin="{x:Static controls:PageLayout.Side}" IsVisible="{Binding IsLoadingMore}"/>
            <Button Classes="quiet" Content="Try again" HorizontalAlignment="Center"
                    Command="{Binding RetryCommand}" IsVisible="{Binding LoadFailed}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
