<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:SoundLibert.UI.Controls"
             x:Class="SoundLibert.UI.Controls.CoverCard">

    <StackPanel Spacing="10" Background="Transparent">
        <controls:AspectBox x:Name="ArtBox">
            <!-- Two layers: the outer casts the shadow, the inner clips the picture
                 to its rounded corners (a clip would cut the shadow off). -->
            <Border x:Name="ArtShadow" Classes="artShadow">
                <Border x:Name="ArtClip" Classes="art">
                    <Panel>
                        <controls:Icon x:Name="Placeholder" Kind="Music" Size="34"
                                       Foreground="{DynamicResource TextFaintBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <controls:CoverMosaic x:Name="Cover"/>
                        <Border Classes="artShade"/>
                        <Border x:Name="BadgeChip" Classes="durationChip" IsVisible="False"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8">
                            <TextBlock x:Name="BadgeText" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#F2FFFFFF"/>
                        </Border>
                        <Button x:Name="MoreButton" Classes="icon sm onHoverCard" IsVisible="False"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                                Background="#B30B0C11" Foreground="#FFFFFF" ToolTip.Tip="More">
                            <controls:Icon Kind="More" Size="16"/>
                        </Button>
                        <Button x:Name="PlayButton" Classes="play cardPlay"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10"
                                ToolTip.Tip="Play">
                            <controls:Icon Kind="Play" Size="20"/>
                        </Button>
                    </Panel>
                </Border>
            </Border>
        </controls:AspectBox>
        <StackPanel Spacing="3">
            <TextBlock x:Name="TitleText" Classes="cardTitle"/>
            <TextBlock x:Name="SubtitleText" Classes="cardSub"/>
        </StackPanel>
    </StackPanel>
</UserControl>
