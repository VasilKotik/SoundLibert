<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:SoundLibert.UI.Controls"
             x:Class="SoundLibert.UI.Controls.NoticeCard"
             Width="372"
             IsVisible="False"
             Opacity="0"
             RenderTransformOrigin="100%,100%"
             RenderTransform="translateY(18px) scale(0.98)">

    <UserControl.Transitions>
        <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.24" Easing="CubicEaseOut"/>
            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.42" Easing="0.2,0,0,1"/>
        </Transitions>
    </UserControl.Transitions>

    <Border Background="{DynamicResource GlassPopupBrush}" CornerRadius="20" Padding="18,16,16,14"
            BorderBrush="{DynamicResource HairlineStrongBrush}" BorderThickness="1"
            BoxShadow="0 18 48 0 #8C000000">
        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <!-- The app's own icon, or a symbol in a soft accent disc. -->
            <Panel Width="46" Height="46" VerticalAlignment="Top">
                <controls:BrandIcon x:Name="Brand" Width="46" Height="46"/>
                <Border x:Name="SymbolDisc" Width="46" Height="46" CornerRadius="23"
                        Background="{DynamicResource AccentSoftBrush}" IsVisible="False">
                    <controls:Icon x:Name="Symbol" Size="22" Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Panel>
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock x:Name="BodyText" FontSize="13" LineHeight="19" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextDimBrush}"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="CloseButton" Classes="icon sm" Width="26" Height="26"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0"
                    ToolTip.Tip="Close" Click="Secondary_Click">
                <controls:Icon Kind="Close" Size="13"/>
            </Button>

            <!-- What a new version changes, a few lines of it. -->
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" x:Name="NotesText" Margin="0,12,0,0"
                       FontSize="12.5" LineHeight="18" TextWrapping="Wrap" MaxLines="6"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMidBrush}"
                       IsVisible="False"/>

            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6"
                        HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="SecondaryButton" Classes="quiet" Click="Secondary_Click"/>
                <Button x:Name="PrimaryButton" Classes="primary" MinHeight="36" Padding="18,0" Click="Primary_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
