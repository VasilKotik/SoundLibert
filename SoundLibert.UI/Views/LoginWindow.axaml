<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:webview="using:Avalonia.Controls"
        x:Class="SoundLibert.UI.Views.LoginWindow"
        Title="Sign in to YouTube Music"
        Width="540" Height="760"
        MinWidth="420" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}">

    <Grid RowDefinitions="Auto,Auto,*">
        <StackPanel Grid.Row="0" Margin="22,18,22,14" Spacing="5">
            <TextBlock Text="Sign in to YouTube Music" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextDimBrush}"
                       Text="This loads your library, playlists and subscriptions. Only the session cookie is stored, on this device; you can sign out at any time."/>
        </StackPanel>

        <ProgressBar Grid.Row="1" x:Name="Busy" IsIndeterminate="True"
                     IsVisible="False" Margin="22,0,22,10"/>

        <webview:NativeWebView Grid.Row="2" x:Name="Web"
                               NavigationCompleted="Web_NavigationCompleted"
                               WebMessageReceived="Web_MessageReceived"/>
    </Grid>
</Window>
