<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SoundLibert.UI.ViewModels"
             xmlns:views="using:SoundLibert.UI.Views"
             xmlns:models="using:SoundLibert.Domain.Models"
             xmlns:controls="using:SoundLibert.UI.Controls"
             x:Class="SoundLibert.UI.Views.CollectionView"
             x:DataType="vm:CollectionViewModel">

    <Grid ClipToBounds="True">
        <!-- Rows are virtualised. The header floats above and scrolls away with them. -->
        <ListBox x:Name="SongsList" Classes="plain" ItemsSource="{Binding Songs}"
                 IsVisible="{Binding HasSongs}"
                 controls:SongRow.NumberRows="{Binding IsAlbumPage}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:SongItem">
                    <controls:SongRow Margin="24,0" Tapped="Song_Tapped"
                                      LikeClick="Like_Click" MoreClick="More_Click"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- After the last track: where to go next. It moves along with the rows. -->
        <views:ShelfStack x:Name="Footer" VerticalAlignment="Top" Margin="32,0"
                          Shelves="{Binding MoreShelves}" IsVisible="{Binding HasMoreShelves}"/>

        <StackPanel x:Name="Header" VerticalAlignment="Top" Spacing="12">
            <controls:PageHero Eyebrow="{Binding KindLabel}"
                               Title="{Binding Title}"
                               Subtitle="{Binding Subtitle}"
                               Meta="{Binding MetaLine}"
                               ImageUrl="{Binding ThumbnailUrl}"
                               ImageUrls="{Binding HeaderCovers}"
                               Glyph="Album">
                <controls:PageHero.Actions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="play" Command="{Binding PlayAllCommand}"
                                IsVisible="{Binding HasSongs}" ToolTip.Tip="Play all">
                            <controls:Icon Kind="Play" Size="22"/>
                        </Button>
                        <Button Classes="icon lg" Command="{Binding ShuffleAllCommand}"
                                IsVisible="{Binding HasSongs}" ToolTip.Tip="Shuffle">
                            <controls:Icon Kind="Shuffle" Size="21"/>
                        </Button>
                        <Button Classes="icon lg" ToolTip.Tip="More">
                            <controls:Icon Kind="More" Size="22"/>
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="Download all"
                                              Command="{Binding DownloadAllCommand}"
                                              IsVisible="{Binding HasSongs}">
                                        <MenuItem.Icon><controls:Icon Kind="Download" Size="16"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{Binding SavePlaylistText}"
                                              Command="{Binding ToggleSavePlaylistCommand}"
                                              IsVisible="{Binding CanSavePlaylist}">
                                        <MenuItem.Icon><controls:Icon Kind="Bookmark" Size="16"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Like album"
                                              Command="{Binding ToggleAlbumLikeCommand}"
                                              IsVisible="{Binding IsAlbumPage}">
                                        <MenuItem.Icon><controls:Icon Kind="Heart" Size="16"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Go to artist"
                                              Click="GoToArtist_Click"
                                              IsVisible="{Binding CanGoToArtist}">
                                        <MenuItem.Icon><controls:Icon Kind="User" Size="16"/></MenuItem.Icon>
                                    </MenuItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </controls:PageHero.Actions>
            </controls:PageHero>

            <!-- Genre mix (playlists): filters the playlist's own songs. -->
            <controls:Rail IsVisible="{Binding IsPlaylistPage}" Margin="32,0,32,8">
                <ItemsControl ItemsSource="{Binding Genres}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GenreChip">
                            <Button Classes="chip" Classes.active="{Binding IsActive}"
                                    Content="{Binding Label}" Tag="{Binding}"
                                    Click="GenreChip_Click"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </controls:Rail>

            <controls:SkeletonPlaceholder Kind="Rows" Count="8" Margin="24,0" IsVisible="{Binding IsLoading}"/>

            <StackPanel Classes="emptyState" IsVisible="{Binding ShowEmpty}">
                <Border Classes="emptyBadge">
                    <controls:Icon Kind="Music" Size="30" Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Classes="emptyText" Text="{Binding EmptyMessage}"/>
            </StackPanel>
        </StackPanel>

        <!-- Once the header has scrolled away: the name and Play stay at hand. -->
        <Border x:Name="Compact" VerticalAlignment="Top" Height="60" Padding="32,0"
                Background="#F20D0E13" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1"
                Opacity="0" IsHitTestVisible="False">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18"/>
                </Transitions>
            </Border.Transitions>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Button Classes="play sm" Command="{Binding PlayAllCommand}" ToolTip.Tip="Play all"
                        VerticalAlignment="Center">
                    <controls:Icon Kind="Play" Size="18"/>
                </Button>
                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
