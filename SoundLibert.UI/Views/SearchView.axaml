<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SoundLibert.UI.ViewModels"
             xmlns:views="using:SoundLibert.UI.Views"
             xmlns:models="using:SoundLibert.Domain.Models"
             xmlns:controls="using:SoundLibert.UI.Controls"
             x:Class="SoundLibert.UI.Views.SearchView"
             x:DataType="vm:SearchViewModel">

    <Grid RowDefinitions="Auto,*">

        <!-- Title + what to search in. The field itself lives in the sidebar. -->
        <StackPanel Grid.Row="0" Margin="32,30,32,6" Spacing="16">
            <TextBlock Classes="display" Text="Search"/>
            <StackPanel x:Name="FilterBar" Orientation="Horizontal" Spacing="6">
                <Button Classes="chip" Content="All" Tag="All" Click="FilterButton_Click"/>
                <Button Classes="chip" Content="Songs" Tag="Songs" Click="FilterButton_Click"/>
                <Button Classes="chip" Content="Videos" Tag="Videos" Click="FilterButton_Click"/>
                <Button Classes="chip" Content="Albums" Tag="Albums" Click="FilterButton_Click"/>
                <Button Classes="chip" Content="Artists" Tag="Artists" Click="FilterButton_Click"/>
                <Button Classes="chip" Content="Playlists" Tag="Playlists" Click="FilterButton_Click"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer x:Name="ResultsScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,14,32,36" Spacing="28">

                <!-- Live suggestions (as you type): searches to run, things to open. -->
                <StackPanel Spacing="2" IsVisible="{Binding HasSuggestions}">
                    <ItemsControl ItemsSource="{Binding Suggestions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Classes="nav" Margin="-12,0,-12,0" Click="Suggestion_Click">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <controls:Icon Kind="Search" Size="16"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding}" FontSize="13.5"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding SuggestionCards}" Margin="-6,6,-6,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ShelfCard">
                                <Border Classes="row" Padding="6" Tag="{Binding}" Tapped="Card_Tapped">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Border Classes="thumb" Width="44" Height="44" CornerRadius="{Binding ThumbRadius}">
                                            <controls:RemoteImage Url="{Binding ThumbnailUrl}" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Classes="rowTitle" Text="{Binding Title}"/>
                                            <TextBlock Classes="rowSub" Text="{Binding Subtitle}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Recent searches -->
                <StackPanel Spacing="10" IsVisible="{Binding HasRecentSearches}">
                    <TextBlock Classes="eyebrow" Text="RECENT"/>
                    <ItemsControl ItemsSource="{Binding RecentSearches}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Classes="chip" Content="{Binding}" Margin="0,0,6,6"
                                        Click="RecentSearch_Click"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- A search found nothing -->
                <StackPanel Classes="emptyState" IsVisible="{Binding ShowEmptyPrompt}">
                    <Border Classes="emptyBadge">
                        <controls:Icon Kind="Search" Size="30" Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Classes="emptyText" Text="Nothing found. Try other words, or explore below."/>
                </StackPanel>

                <!-- Loading -->
                <controls:SkeletonPlaceholder Kind="Rows" Count="7" IsVisible="{Binding IsSearching}"/>

                <!-- The best match -->
                <Border Classes="bestMatch" IsVisible="{Binding HasTopResult}" Tapped="TopResult_Tapped">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="22">
                        <Border Width="120" Height="120" CornerRadius="{Binding TopResultRadius}" ClipToBounds="True"
                                Background="{DynamicResource ArtGradient}" VerticalAlignment="Center">
                            <ContentControl Content="{Binding TopResult}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:ShelfCard">
                                        <controls:RemoteImage Url="{Binding ThumbnailUrl}" Stretch="UniformToFill"/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        </Border>
                        <ContentControl Grid.Column="1" VerticalAlignment="Center" Content="{Binding TopResult}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="vm:ShelfCard">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="eyebrow" Text="BEST MATCH"/>
                                        <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="Bold"
                                                   LetterSpacing="-0.5" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="13.5"
                                                   Foreground="{DynamicResource TextMidBrush}" TextTrimming="CharacterEllipsis"/>
                                        <Button Classes="play sm" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                IsVisible="{Binding CanPlay}"
                                                Click="TopResultPlay_Click" ToolTip.Tip="Play">
                                            <controls:Icon Kind="Play" Size="18"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                        <ItemsControl Grid.Column="2" Width="340" VerticalAlignment="Center"
                                      ItemsSource="{Binding TopResultSongs}" IsVisible="{Binding HasTopResultSongs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ShelfCard">
                                    <Border Classes="row" Padding="6" Tag="{Binding}" Tapped="Card_Tapped">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                                            <Border Classes="thumb" Width="42" Height="42">
                                                <Panel>
                                                    <controls:RemoteImage Url="{Binding ThumbnailUrl}" Stretch="UniformToFill"/>
                                                    <Border Classes="thumbShade hoverOnly">
                                                        <controls:Icon Kind="Play" Size="16" Foreground="#FFFFFF"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </Panel>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Classes="rowTitle" Text="{Binding Title}"/>
                                                <TextBlock Classes="rowSub" Text="{Binding Subtitle}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- "All": a shelf of everything found -->
                <views:ShelfStack Shelves="{Binding OverviewShelves}" IsVisible="{Binding HasOverview}"/>

                <!-- Songs -->
                <StackPanel Spacing="8" IsVisible="{Binding ShowSongList}">
                    <TextBlock Classes="section-title" Text="Songs"/>
                    <ItemsControl ItemsSource="{Binding Songs}" Margin="-8,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:SongItem">
                                <controls:SongRow Reveal="True" Tapped="Song_Tapped"
                                                  LikeClick="Like_Click" MoreClick="More_Click"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Videos -->
                <StackPanel Spacing="8" IsVisible="{Binding HasVideos}">
                    <TextBlock Classes="section-title" Text="Videos"/>
                    <ItemsControl ItemsSource="{Binding Videos}" Margin="-8,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:SongItem">
                                <controls:SongRow Reveal="True" Tapped="Song_Tapped"
                                                  LikeClick="Like_Click" MoreClick="More_Click"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Albums -->
                <StackPanel Spacing="14" IsVisible="{Binding HasAlbums}">
                    <TextBlock Classes="section-title" Text="Albums"/>
                    <ItemsControl ItemsSource="{Binding Albums}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:AdaptiveGrid MinItemWidth="160"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:AlbumItem">
                                <controls:CoverCard Title="{Binding Title}" Subtitle="{Binding Subtitle}"
                                                    ImageUrl="{Binding ThumbnailUrl}" Tapped="Album_Tapped"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Artists -->
                <StackPanel Spacing="14" IsVisible="{Binding HasArtists}">
                    <TextBlock Classes="section-title" Text="Artists"/>
                    <ItemsControl ItemsSource="{Binding Artists}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:AdaptiveGrid MinItemWidth="140"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ArtistItem">
                                <controls:CoverCard Shape="Round" Title="{Binding Name}" Subtitle="{Binding Subtitle}"
                                                    ImageUrl="{Binding ThumbnailUrl}" Tapped="Artist_Tapped"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Playlists -->
                <StackPanel Spacing="14" IsVisible="{Binding HasPlaylists}">
                    <TextBlock Classes="section-title" Text="Playlists"/>
                    <ItemsControl ItemsSource="{Binding Playlists}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:AdaptiveGrid MinItemWidth="160"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:PlaylistItem">
                                <controls:CoverCard Title="{Binding Title}" Subtitle="{Binding Subtitle}"
                                                    ImageUrl="{Binding ThumbnailUrl}" Tapped="Playlist_Tapped"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Before a search: moods, what is moving, what is new. -->
                <views:ShelfStack Shelves="{Binding DiscoverShelves}" IsVisible="{Binding ShowDiscover}"/>
                <controls:SkeletonPlaceholder Kind="Cards" Count="6" ClipToBounds="True" IsVisible="{Binding IsLoadingDiscover}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- The results go under the filters with a soft edge, once there are any under them. -->
        <Border x:Name="ResultsEdge" Grid.Row="1" Height="22" VerticalAlignment="Top"
                Opacity="0" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#F20C0D12"/>
                    <GradientStop Offset="1" Color="#000C0D12"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
    </Grid>
</UserControl>
